{
	"name": "lognow",
	"version": "0.8.0",
	"description": "Quick and clean universal logging.",
	"keywords": [
		"logging",
		"loglayer",
		"log",
		"electron",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/lognow",
	"bugs": "https://github.com/kitschpatrol/lognow/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/lognow.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"node": {
				"types": "./dist/node/index.d.ts",
				"import": "./dist/node/index.js"
			},
			"browser": {
				"types": "./dist/browser/index.d.ts",
				"import": "./dist/browser/index.js"
			},
			"default": {
				"types": "./dist/browser/index.d.ts",
				"import": "./dist/browser/index.js"
			}
		},
		"./electron-preload": {
			"types": "./dist/electron-preload/index.d.ts",
			"import": "./dist/electron-preload/index.js"
		},
		"./standalone": {
			"types": "./dist/standalone/index.d.ts",
			"import": "./dist/standalone/index.js"
		}
	},
	"jsdelivr": "./dist/standalone/index.js",
	"unpkg": "./dist/standalone/index.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"bench": "vitest bench --run --project \"node (bench)\" --reporter=default",
		"bench:baseline": "vitest bench --run --project \"node (bench)\" --reporter=default --reporter=json --outputFile=test/benchmarks/baseline.json",
		"build": "tsdown && attw -P --profile esm-only && publint",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run",
		"test:browser": "vitest run --project browser",
		"test:node": "vitest run --project node"
	},
	"dependencies": {
		"@kitschpatrol/node-inspect-extracted": "3.3.3-fork.1",
		"@kitschpatrol/safe-stable-stringify": "2.5.0-fork.1",
		"@loglayer/context-manager": "^2.3.0",
		"@loglayer/transport": "^3.3.0",
		"@loglayer/transport-log-file-rotation": "^3.3.0",
		"@types/node": "~20.19.43",
		"defu": "^6.1.7",
		"filenamify": "^7.0.3",
		"loglayer": "^9.4.0",
		"next-json": "^0.5.1",
		"read-package-up": "^12.0.0",
		"serialize-error": "^13.0.1",
		"terminal-size": "^4.0.1",
		"tinyrainbow": "^3.1.1",
		"untildify": "^6.0.0",
		"wrap-ansi": "^10.0.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.8.0",
		"@playwright/test": "^1.63.0",
		"@vitest/browser-playwright": "^5.0.1",
		"bumpp": "^12.3.0",
		"electron": "39.8.5",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"electron": ">=39.8.5"
	},
	"peerDependenciesMeta": {
		"electron": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=20.19.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.16.0"
		}
	}
}
